{
  "name": "@emitkit/js",
  "version": "3.0.0",
  "description": "The EmitKit SDK: send events, ask people for decisions from their phone, and read the answers.",
  "keywords": [
    "emitkit",
    "events",
    "push notifications",
    "human in the loop",
    "approvals",
    "agents",
    "sdk"
  ],
  "homepage": "https://emitkit.com/docs/sdk",
  "bugs": {
    "url": "https://github.com/emitkithq/sdks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emitkithq/sdks.git",
    "directory": "packages/js"
  },
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi/openapi.json --default-non-nullable false -o src/generated/openapi.ts",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --dir test",
    "test:e2e": "vitest run --dir e2e",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "openapi-typescript": "^7.13.0",
    "standardwebhooks": "1.1.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
