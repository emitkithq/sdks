{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2023"
    ],
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": "./dist",
    "paths": {
      "@emitkit/js": [
        "../js/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
